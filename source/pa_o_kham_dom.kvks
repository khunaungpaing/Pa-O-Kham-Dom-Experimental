<?xml version="1.0" encoding="utf-8"?>
<!--
  Pa-O Kham Dom Experimental visual keyboard source.
  This file affects only the on-screen keyboard labels; typing behavior remains
  defined by pa_o_kham_dom.kmn.  Combining marks are shown with a dotted circle
  where useful so their position is clear to the user.
-->
